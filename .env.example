# Telegram is the required primary notification channel.
# Create a bot with @BotFather, message it once, then set the numeric chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional fallback channels. Secrets may be combined.

# Slack (legacy fallback)
SLACK_WEBHOOK_ALL=
SLACK_WEBHOOK_HIGH=

# Discord incoming webhooks
DISCORD_WEBHOOK_ALL=
DISCORD_WEBHOOK_HIGH=

# ntfy topic URL, for example https://ntfy.sh/a-long-private-topic-name
NTFY_TOPIC_URL=
NTFY_TOKEN=

# Pushover
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Optional: post a run summary to all configured general channels.
POST_RUN_SUMMARY=false
