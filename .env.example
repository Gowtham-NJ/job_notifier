# Configure one or more notification channels. Secrets may be combined.

# Slack (existing default)
SLACK_WEBHOOK_ALL=
SLACK_WEBHOOK_HIGH=

# Discord incoming webhooks
DISCORD_WEBHOOK_ALL=
DISCORD_WEBHOOK_HIGH=

# Telegram bot created with @BotFather; message the bot once, then set the chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy topic URL, for example https://ntfy.sh/a-long-private-topic-name
NTFY_TOPIC_URL=
NTFY_TOKEN=

# Pushover
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Optional: post a run summary to all configured general channels.
POST_RUN_SUMMARY=false
